-- Builds the CaMPL toolchain to WebAssembly with the GHC wasm backend:
-- MPL (frontend) + MPLASM (assembler) + MPLMACH (abstract machine).
-- Use the ghc-wasm-meta toolchain: `source ~/.ghc-wasm/env` then
-- `wasm32-wasi-cabal build mpl-wasm` (see build.sh).
--
-- MPLMACH's socket/process service layer is replaced with a JS bridge under
-- `if arch(wasm32)` (see MPLMACH.cabal + MplMach.MplMachStep #ifdef WASM).

packages:
  ./mpl-wasm
  ../../campl/MPL
  ../../campl/MPLASM
  ../../campl/MPLMACH

-- The research codebase emits many warnings; don't let -Werror-ish defaults bite.
package MPL
  ghc-options: -w

package MPLASM
  ghc-options: -w

package MPLMACH
  ghc-options: -w

package mpl-wasm
  ghc-options: -w
