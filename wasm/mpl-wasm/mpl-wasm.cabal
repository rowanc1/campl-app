cabal-version:      3.0
name:               mpl-wasm
version:            0.1.0.0
synopsis:           WebAssembly entry point for the CaMPL frontend
build-type:         Simple

executable mpl-wasm
  main-is:          CamplWasm.hs
  hs-source-dirs:   src
  default-language: Haskell2010
  build-depends:
      base
    , ghc-experimental
    , MPL
  ghc-options:
    -no-hs-main
    -optl-mexec-model=reactor
    "-optl-Wl,--export=camplCompile"
    "-optl-Wl,--export=hs_init"
